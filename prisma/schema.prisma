generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model appointment_type_providers {
  id                String            @id
  appointmentTypeId String
  providerId        String
  appointment_types appointment_types @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
  provider_slots    provider_slots    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([appointmentTypeId, providerId])
}

model appointment_types {
  id                         String                       @id
  name                       String
  description                String?
  duration                   Int
  isPublished                Boolean                      @default(false)
  shareToken                 String                       @unique
  maxBookingsPerSlot         Int                          @default(1)
  requiresPayment            Boolean                      @default(false)
  paymentAmount              Float?
  requiresConfirmation       Boolean                      @default(false)
  scheduleType               SlotScheduleType             @default(WEEKLY)
  assignmentType             AssignmentType               @default(AUTO)
  location                   String?
  organiserId                String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  appointment_type_providers appointment_type_providers[]
  users                      users                        @relation(fields: [organiserId], references: [id])
  bookings                   bookings[]
  questions                  questions[]
  weekly_schedules           weekly_schedules[]
}

model booking_answers {
  id         String    @id
  bookingId  String
  questionId String
  answer     String
  bookings   bookings  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  questions  questions @relation(fields: [questionId], references: [id])
}

model bookings {
  id                String            @id
  appointmentTypeId String
  customerId        String
  providerId        String?
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(PENDING)
  capacity          Int               @default(1)
  notes             String?
  confirmationCode  String            @unique
  isPaid            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  booking_answers   booking_answers[]
  appointment_types appointment_types @relation(fields: [appointmentTypeId], references: [id])
  users             users             @relation(fields: [customerId], references: [id])
  provider_slots    provider_slots?   @relation(fields: [providerId], references: [id])
}

model provider_slots {
  id                         String                       @id
  name                       String
  userId                     String?
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  appointment_type_providers appointment_type_providers[]
  bookings                   bookings[]
  users                      users?                       @relation(fields: [userId], references: [id])
}

model questions {
  id                String            @id
  appointmentTypeId String
  questionText      String
  isRequired        Boolean           @default(false)
  order             Int               @default(0)
  booking_answers   booking_answers[]
  appointment_types appointment_types @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
}

model users {
  id                String              @id
  name              String
  email             String              @unique
  password          String
  role              UserRole            @default(CUSTOMER)
  isActive          Boolean             @default(true)
  otpCode           String?
  otpExpiry         DateTime?
  isVerified        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  appointment_types appointment_types[]
  bookings          bookings[]
  provider_slots    provider_slots[]
}

model weekly_schedules {
  id                String            @id
  appointmentTypeId String
  dayOfWeek         Int
  startTime         String
  endTime           String
  appointment_types appointment_types @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum AssignmentType {
  AUTO
  MANUAL
}

enum SlotScheduleType {
  WEEKLY
  FLEXIBLE
}

enum UserRole {
  CUSTOMER
  ORGANISER
  ADMIN
}
